{
  "name": "code-guide",
  "version": "0.1.0",
  "description": "Read code and code changes as a few brief, guided chapters.",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsup --watch",
    "build": "tsc --noEmit && vite build && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepare": "npm run build",
    "check": "npm run typecheck && npm run format:check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heron--/code-chapters.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/heron--/code-chapters/issues"
  },
  "homepage": "https://github.com/heron--/code-chapters#readme",
  "dependencies": {
    "open": "^11.0.4",
    "shiki": "^4.5.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "bin": {
    "code-guide": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "GLOSSARY.md"
  ],
  "engines": {
    "node": ">=22.12"
  }
}
